{
  "name": "circleit",
  "displayName": "CircleIt",
  "version": "0.5.2",
  "description": "Draw on any web page in Chrome and send design feedback straight into this session.",
  "author": { "name": "CircleIt" },
  "keywords": ["design", "feedback", "annotation", "chrome", "screenshots", "frontend"],
  "mcpServers": {
    "circleit": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/circleit.mjs", "mcp", "--client", "claude-code"]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/server/circleit.mjs", "hook", "prompt"], "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/server/circleit.mjs", "hook", "stop"], "timeout": 5 }
        ]
      }
    ]
  },
  "experimental": {
    "monitors": [
      {
        "name": "feedback",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/server/circleit.mjs\" monitor --client claude-code",
        "description": "CircleIt design feedback from your browser"
      }
    ]
  }
}
